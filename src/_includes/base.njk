<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title | oneline }} · {{ site.name | oneline }}{% else %}{{ site.title_tag | oneline }}{% endif %}</title>
  <meta name="description" content="{{ (description or site.description) | oneline }}">
  <meta name="author" content="{{ site.name | oneline }}">
  {% if robots %}<meta name="robots" content="{{ robots }}">{% endif %}
  <meta property="og:title" content="{% if title %}{{ title | oneline }} · {{ site.name | oneline }}{% else %}{{ site.title_tag | oneline }}{% endif %}">
  <meta property="og:description" content="{{ (description or site.description) | oneline }}">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="ko_KR">
  <meta property="og:site_name" content="{{ site.title_tag | oneline }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {%- set ogimg = og_image or site.og_image or '/assets/og.png' %}
  <meta property="og:image" content="{% if ogimg.startsWith('http') %}{{ ogimg }}{% else %}{{ site.url }}{{ ogimg }}{% endif %}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ (site.og_image_alt or site.title_tag) | oneline }}">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {%- set theme = site.theme or 'classic' %}
  {% if theme == 'apple' %}<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/theme-apple.css">{% else %}<link href="https://fonts.googleapis.com/css2?family=Black+Han+Sans&family=Noto+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/style.css">{% endif %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": {{ site.name | oneline | dump | safe }},
    "jobTitle": {{ site.job_title | oneline | dump | safe }},
    "description": {{ site.description | oneline | dump | safe }},
    "worksFor": { "@type": "Organization", "name": {{ site.organization | oneline | dump | safe }}, "url": {{ site.links[0].url | dump | safe }} },
    "alumniOf": { "@type": "EducationalOrganization", "name": {{ site.alumni | oneline | dump | safe }} },
    "sameAs": [{% for l in site.links %}{{ l.url | dump | safe }}{% if not loop.last %}, {% endif %}{% endfor %}],
    "knowsAbout": [{% for k in site.keywords %}{{ k | dump | safe }}{% if not loop.last %}, {% endif %}{% endfor %}]
  }
  </script>
  {% if page.url == '/' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- set faqs = [] -%}
      {%- for s in home.sections | enabled %}{% if s.faq and s.heading and s.lead %}{% set faqs = (faqs.push(s), faqs) %}{% endif %}{% endfor -%}
      {%- for s in faqs %}
      { "@type": "Question", "name": {{ s.heading | oneline | dump | safe }}, "acceptedAnswer": { "@type": "Answer", "text": {{ s.lead | oneline | dump | safe }} } }{% if not loop.last %},{% endif %}
      {%- endfor %}
    ]
  }
  </script>
  {% endif %}
  {% block head %}{% endblock %}
</head>
<body class="theme-{{ theme }}">

<header class="site">
  <div class="wrap-wide">
    <a class="brand" href="/">{{ site.name | br | safe }}</a>
    <nav aria-label="페이지 안내">
      {% for item in navigation.items | visible %}<a href="{{ item.url }}"{% if item.hide_on_mobile %} class="nav-hide"{% endif %}>{{ item.label | br | safe }}</a>{% endfor %}
    </nav>
  </div>
</header>

<main id="top">
{{ content | safe }}
</main>

<footer class="site">
  <div class="wrap">
    <p>{{ site.byline | br | safe }}</p>
    <p>{% for l in site.links %}<a href="{{ l.url }}" rel="noopener">{{ l.label | br | safe }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p>
    <p>{{ site.copyright | br | safe }}</p>
  </div>
</footer>

</body>
</html>
