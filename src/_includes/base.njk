<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title | oneline }} · {{ site.name | oneline }}{% else %}{{ site.title_tag | oneline }}{% endif %}</title>
  <meta name="description" content="{{ (description or site.description) | oneline }}">
  <meta name="author" content="{{ site.name | oneline }}">
  {% if robots %}<meta name="robots" content="{{ robots }}">{% endif %}
  <meta property="og:title" content="{% if title %}{{ title | oneline }} · {{ site.name | oneline }}{% else %}{{ site.title_tag | oneline }}{% endif %}">
  <meta property="og:description" content="{{ (description or site.description) | oneline }}">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="ko_KR">
  <meta property="og:site_name" content="{{ site.title_tag | oneline }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {%- set ogimg = og_image or site.og_image or '/assets/og.png' %}
  <meta property="og:image" content="{% if ogimg.startsWith('http') %}{{ ogimg }}{% else %}{{ site.url }}{{ ogimg }}{% endif %}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ (site.og_image_alt or site.title_tag) | oneline }}">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {%- set theme = site.theme or 'classic' %}
{% set studio_home = site.homepage_layout == 'studio' and theme == 'beagle' and page.url == '/' %}
  {% if theme == 'beagle' %}<link rel="stylesheet" href="/assets/theme-beagle.css?v=footer-17">
  {% elif theme == 'tesla' %}<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/theme-apple.css">
  <link rel="stylesheet" href="/assets/theme-tesla.css">
  {% elif theme == 'claude' %}<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;500&family=Noto+Sans+KR:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/theme-apple.css">
  <link rel="stylesheet" href="/assets/theme-claude.css">
  {% elif theme == 'notion' %}<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/theme-apple.css">
  <link rel="stylesheet" href="/assets/theme-notion.css">
  {% elif theme == 'apple' %}<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/theme-apple.css">{% else %}<link href="https://fonts.googleapis.com/css2?family=Black+Han+Sans&family=Noto+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/style.css">{% endif %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": {{ site.name | oneline | dump | safe }},
    "jobTitle": {{ site.job_title | oneline | dump | safe }},
    "description": {{ site.description | oneline | dump | safe }},
    "worksFor": { "@type": "Organization", "name": {{ site.organization | oneline | dump | safe }}, "url": {{ site.links[0].url | dump | safe }} },
    "alumniOf": { "@type": "EducationalOrganization", "name": {{ site.alumni | oneline | dump | safe }} },
    "sameAs": [{% for l in site.links %}{{ l.url | dump | safe }}{% if not loop.last %}, {% endif %}{% endfor %}],
    "knowsAbout": [{% for k in site.keywords %}{{ k | dump | safe }}{% if not loop.last %}, {% endif %}{% endfor %}]
  }
  </script>
  {% if page.url == '/' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- set faqs = [] -%}
      {%- for s in home.sections | enabled %}{% if s.faq and s.heading and s.lead %}{% set faqs = (faqs.push(s), faqs) %}{% endif %}{% endfor -%}
      {%- for s in faqs %}
      { "@type": "Question", "name": {{ s.heading | oneline | dump | safe }}, "acceptedAnswer": { "@type": "Answer", "text": {{ s.lead | oneline | dump | safe }} } }{% if not loop.last %},{% endif %}
      {%- endfor %}
    ]
  }
  </script>
  {% endif %}
  {% if motion_demo or studio_page or studio_home %}<link rel="stylesheet" href="/assets/motion-demo.css?v=studio-21">{% endif %}
  {% block head %}{% endblock %}
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/text-layout.css">
</head>
<body {% if studio_home or motion_demo %}data-studio-home-values="{{ home | dump }}"{% endif %} data-home-canvas-appearance="{{ (home.appearance or {}) | dump }}" data-canvas-appearance="[{{ (site.appearance or {}) | dump }},{{ (navigation.appearance or {}) | dump }},{% if page.url == '/' %}{{ (home.appearance or {}) | dump }}{% else %}{{ (appearance or {}) | dump }}{% endif %}]" data-site-appearance="{{ (site.appearance or {}) | dump }}" class="theme-{{ theme }}{% if motion_demo or studio_page or studio_home %} motion-demo{% endif %}{% if studio_page %} product-page{% endif %}">

<header class="site">
  <div class="wrap-wide">
    <a class="brand" href="/">{% if theme == 'beagle' %}<img class="brand-horizontal" src="/assets/brand/church-ai-lab-horizontal.png" alt="Church AI Lab · 교회를 위한 AI 연구소" width="2164" height="727">{% elif theme == 'tesla' or theme == 'claude' or theme == 'notion' %}{{ site.title_tag | oneline }}{% else %}{{ site.name | br | safe }}{% endif %}</a>
    <nav data-appearance="{{ (navigation.appearance or {}) | dump }}" aria-label="페이지 안내">
      {% for item in navigation.items %}{% if item.visible != false %}<a data-nav-index="{{ loop.index0 }}" data-item-appearance="{{ item.appearance | dump }}" href="{% if design_preview and (theme == 'tesla' or theme == 'claude' or theme == 'notion' or theme == 'beagle') and (item.url.startsWith('#') or item.url.startsWith('/#')) %}/{{ theme }}-preview/{{ item.url | replace('/#', '#') }}{% else %}{{ item.url }}{% endif %}"{% if item.hide_on_mobile %} class="nav-hide"{% endif %}>{{ item.label | br | safe }}</a>{% endif %}{% endfor %}
    </nav>
  </div>
</header>

{% if design_preview and theme == 'tesla' %}<aside class="preview-notice" aria-label="로컬 디자인 미리보기"><span>Tesla 스타일 미리보기</span><a href="/">현재 홈페이지 ↗</a></aside>{% endif %}
{% if design_preview and theme == 'claude' %}<aside class="preview-notice" aria-label="로컬 디자인 미리보기"><span>Claude 스타일 미리보기</span><div><a href="/">현재 홈페이지</a><a href="/tesla-preview/">Tesla 디자인 ↗</a></div></aside>{% endif %}
{% if design_preview and theme == 'notion' %}<aside class="preview-notice" aria-label="로컬 디자인 미리보기"><span>Notion 스타일 미리보기</span><div><a href="/">현재 홈페이지</a><a href="/tesla-preview/">Tesla</a><a href="/claude-preview/">Claude</a></div></aside>{% endif %}
{% if design_preview and theme == 'beagle' %}<aside class="demo-notice" aria-label="디자인 미리보기"><span>DESIGN STUDY / BEAGLE</span><a href="/">현재 홈페이지 ↗</a></aside>{% endif %}
<main id="top" data-appearance="{{ (appearance or {}) | dump }}">
{{ content | safe }}
</main>

<footer class="site">
  <div class="wrap footer-profile">
    {% if theme == 'beagle' %}<div class="footer-logo"><a href="/" aria-label="Church AI Lab 홈"><img src="/assets/brand/church-ai-lab-stacked.png" alt="Church AI Lab · 교회를 위한 AI 연구소" width="308" height="294" loading="lazy"></a></div>{% endif %}
    <div class="footer-details">
      <p>{{ site.byline | br | safe }}</p>
      <p class="footer-affiliations">{% for l in site.links %}<a data-item-appearance="{{ l.appearance | dump }}" href="{{ l.url }}" rel="noopener">{{ l.label | br | safe }}</a>{% if not loop.last %}<span class="footer-separator"> · </span>{% endif %}{% endfor %}</p>
      <p>{{ site.copyright | br | safe }}</p>
      <a href="/admin/" class="admin-shortcut">관리자</a>{% if studio_home %} <button class="footer-motion-toggle" type="button" data-motion-toggle aria-pressed="true">모션 켜짐</button>{% endif %}
    </div>
  </div>
</footer>

<script src="/assets/visual-layout.js?v=studio21" defer></script>
{% if theme == 'beagle' and not studio_home and not motion_demo %}<script src="/assets/showcase.js" defer></script>{% endif %}
<script src="/assets/text-layout.js" defer></script>
{% if motion_demo or studio_home %}<script src="/assets/motion-demo.js?v=studio-21" defer></script>{% endif %}
{% if studio_page %}<script src="/assets/sermon-motion.js?v=studio21" defer></script>{% endif %}
</body>
</html>
