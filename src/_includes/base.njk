<!doctype html>
<html lang="ko">
<head>
  <meta name="naver-site-verification" content="3a0d614af56d8d2feaec4ee4e3ed8090ce353875" />
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48 64x64">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/icons/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/icons/favicon-16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/icons/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#102858">
  <title>{% if title %}{{ title | oneline }} · {{ site.name | oneline }}{% else %}{{ site.title_tag | oneline }}{% endif %}</title>
  <meta name="description" content="{{ (description or site.description) | oneline }}">
  <meta name="author" content="{{ site.name | oneline }}">
  <link rel="describedby" href="{{ site.url }}/llms.txt" type="text/plain">
  {% if robots %}<meta name="robots" content="{{ robots }}">{% endif %}
  {% set share_title = og_title or (title ~ ' · ' ~ site.organization if title else site.title_tag) %}
  {% set share_description = og_description or description or site.description %}
  {% set share_image_alt = og_image_alt or site.og_image_alt or site.title_tag %}
  <meta property="og:title" content="{{ share_title | oneline | escape }}">
  <meta property="og:description" content="{{ share_description | oneline | escape }}">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="ko_KR">
  <meta property="og:site_name" content="{{ site.organization | oneline | escape }}">
  <meta property="og:url" content="{{ (site.url ~ page.url) | escape }}">
  {%- set ogimg = og_image or site.og_image or '/assets/og.png' %}
  {% if ogimg.startsWith('https://') %}{% set share_image_url = ogimg %}{% elif ogimg.startsWith('http://') %}{% set share_image_url = 'https://' ~ ogimg.slice(7) %}{% else %}{% set share_image_url = site.url ~ ogimg %}{% endif %}
  <meta property="og:image" content="{{ share_image_url | escape }}">
  <meta property="og:image:secure_url" content="{{ share_image_url | escape }}">
  <meta property="og:image:type" content="{{ ogimg | imageMime }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ share_image_alt | oneline | escape }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ share_title | oneline | escape }}">
  <meta name="twitter:description" content="{{ share_description | oneline | escape }}">
  <meta name="twitter:image" content="{{ share_image_url | escape }}">
  <meta name="twitter:image:alt" content="{{ share_image_alt | oneline | escape }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {# Studio is the default shell for every page, including CMS-created pages. #}
  {% set theme = 'beagle' %}
  {% set studio_home = page.url == '/' %}
  {% if (home | hasSerif) or (site | hasSerif) or (navigation | hasSerif) or (appearance | hasSerif) %}<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>{% endif %}
  <style data-studio-css="theme-beagle.css motion-demo.css text-layout.css document.css">{{ inlineStyles.studio | safe }}</style>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": {{ site.name | oneline | dump | safe }},
    "jobTitle": {{ site.job_title | oneline | dump | safe }},
    "description": {{ site.description | oneline | dump | safe }},
    "worksFor": { "@type": "Organization", "name": {{ site.organization | oneline | dump | safe }}, "url": {{ site.links[0].url | dump | safe }} },
    "alumniOf": { "@type": "EducationalOrganization", "name": {{ site.alumni | oneline | dump | safe }} },
    "sameAs": [{% for l in site.links %}{{ l.url | dump | safe }}{% if not loop.last %}, {% endif %}{% endfor %}],
    "knowsAbout": [{% for k in site.keywords %}{{ k | dump | safe }}{% if not loop.last %}, {% endif %}{% endfor %}]
  }
  </script>
  {% if page.url == '/' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- set faqs = [] -%}
      {%- for s in home.sections | enabled %}{% if s.faq and s.heading and s.lead %}{% set faqs = (faqs.push(s), faqs) %}{% endif %}{% endfor -%}
      {%- for s in faqs %}
      { "@type": "Question", "name": {{ s.heading | oneline | dump | safe }}, "acceptedAnswer": { "@type": "Answer", "text": {{ s.lead | oneline | dump | safe }} } }{% if not loop.last %},{% endif %}
      {%- endfor %}
    ]
  }
  </script>
  {% endif %}
  {% block head %}{% endblock %}
  {% if ((home | hasSerif) or (site | hasSerif) or (navigation | hasSerif) or (appearance | hasSerif)) %}<link data-visual-serif href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;500;600;700&display=swap" rel="stylesheet">{% endif %}
</head>
<body {% if studio_home or motion_demo %}data-studio-home-values="{{ home | dump }}"{% endif %} data-home-canvas-appearance="{{ (home.appearance or {}) | dump }}" data-canvas-appearance="[{{ (site.appearance or {}) | dump }},{{ (navigation.appearance or {}) | dump }},{% if page.url == '/' %}{{ (home.appearance or {}) | dump }}{% else %}{{ (appearance or {}) | dump }}{% endif %}]" data-site-appearance="{{ (site.appearance or {}) | dump }}" class="theme-beagle motion-demo{% if studio_page %} product-page{% endif %}">

<header class="site">
  <div class="wrap-wide">
    <a class="brand" href="/"><img class="brand-horizontal" src="/assets/brand/church-ai-lab-horizontal.webp" alt="Church AI Lab · 교회를 위한 AI 연구소" width="600" height="202" decoding="async" fetchpriority="high"></a>
    <nav data-appearance="{{ (navigation.appearance or {}) | dump }}" aria-label="페이지 안내">
      {% for item in navigation.items %}{% if item.visible != false %}<a data-nav-index="{{ loop.index0 }}" data-item-appearance="{{ item.appearance | dump }}" href="{{ item.url }}"{% if item.hide_on_mobile %} class="nav-hide"{% endif %}>{{ item.label | br | safe }}</a>{% endif %}{% endfor %}
    </nav>
  </div>
</header>

<main id="top" data-appearance="{{ (appearance or {}) | dump }}">
{{ content | safe }}
</main>

<footer class="site">
  <div class="wrap footer-profile">
    <div class="footer-logo"><a href="/" aria-label="Church AI Lab 홈"><img src="/assets/brand/church-ai-lab-stacked.webp" alt="Church AI Lab · 교회를 위한 AI 연구소" width="308" height="294" loading="lazy"></a></div>
    <div class="footer-details">
      <p>{{ site.byline | br | safe }}</p>
      <p class="footer-affiliations">{% for l in site.links %}<a data-item-appearance="{{ l.appearance | dump }}" href="{{ l.url }}" rel="noopener">{{ l.label | br | safe }}</a>{% if not loop.last %}<span class="footer-separator"> · </span>{% endif %}{% endfor %}</p>
      <p>{{ site.copyright | br | safe }}</p>
      <a href="/admin/" class="admin-shortcut">관리자</a>{% if studio_home %} <button class="footer-motion-toggle" type="button" data-motion-toggle aria-pressed="true">모션 켜짐</button>{% endif %}
    </div>
  </div>
</footer>

{% if (home | hasAppearance) or (site | hasAppearance) or (navigation | hasAppearance) or appearance %}<script src="/assets/visual-layout.js?v=perf24" defer></script>{% endif %}
{% if theme == 'beagle' and not studio_home and not motion_demo %}<script src="/assets/showcase.js" defer></script>{% endif %}
<script src="/assets/text-layout.js" defer></script>
<script src="/assets/copy-prompts.js" defer></script>
<script src="/assets/header-motion.js" defer></script>
{% if motion_demo or studio_home %}<script src="/assets/motion-demo.js?v=studio-21" defer></script>{% endif %}
{% if studio_page %}<script src="/assets/sermon-motion.js?v=studio21" defer></script>{% endif %}
</body>
</html>
