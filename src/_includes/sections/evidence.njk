{% set typography = s.typography %}
<section data-appearance="{{ s.appearance | dump }}" {% include "text-layout.njk" %} class="tone-{{ s._tone or 'light' }}" id="{{ s.id }}">
  <div class="wrap">
    <h2>{{ s.heading | br | safe }}</h2>
    {% if s.id == "about" %}<img src="/assets/shin-soochul-profile.webp" alt="신수철 목사 프로필" width="150" height="199" loading="lazy" style="width:150px;height:auto;display:block;margin:20px 0;">{% endif %}
    {% if s.lead %}<p>{{ s.lead | br | safe }}</p>{% endif %}
    <dl class="evidence">
      {% for e in s.items %}
      <div data-item-appearance="{{ e.appearance | dump }}">
        <dt>{{ e.kind | br | safe }}</dt>
        <dd>{% if e.link_url and e.link_label %}{{ e.body | br | replace(e.link_label, '<a href="' ~ e.link_url ~ '" rel="noopener">' ~ e.link_label ~ '</a>') | safe }}{% else %}{{ e.body | br | safe }}{% endif %}</dd>
      </div>
      {% endfor %}
    </dl>
  </div>
</section>
