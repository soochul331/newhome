<section class="tone-{{ s._tone or 'light' }}" id="{{ s.id or 'contact' }}">
  <div class="wrap">
    <h2>{{ s.heading | br | safe }}</h2>
    {% if s.lead %}<p>{{ s.lead | br | safe }}</p>{% endif %}
    {% if s.form_enabled %}
    <form class="contact" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thanks.html">
      <input type="hidden" name="form-name" value="contact">
      <p class="hidden"><label>사람이시면 비워 두세요 <input name="bot-field"></label></p>
      <label><span class="label">성함</span><input type="text" name="name" required autocomplete="name"></label>
      <label><span class="label">이메일</span><input type="email" name="email" required autocomplete="email"></label>
      <label><span class="label">문의 내용</span><textarea name="message" required></textarea></label>
      <div><button class="btn btn-primary" type="submit">문의 보내기</button></div>
    </form>
    {% endif %}
    {% if s.closing %}<p class="muted" style="margin-top: var(--space-6);">{{ s.closing | br | safe }}</p>{% endif %}
  </div>
</section>
