{% set typography = s.typography %}
<section {% include "text-layout.njk" %} class="hero claude-hero" id="{{ s.id or 'hero' }}">
  <div class="wrap-wide hero-layout">
    <div class="hero-copy">
      <p class="hero-eyebrow">{{ site.name | oneline }}</p>
      <h1>{{ s.title | oneline }}</h1>
      {% if s.lead %}<p class="lead">{{ s.lead | oneline }}</p>{% endif %}
      <div class="actions">
        {% if s.primary.label %}<a class="btn btn-primary" href="{{ s.primary.url }}">{{ s.primary.label | br | safe }}</a>{% endif %}
        {% if s.secondary.label %}<a class="btn btn-secondary" href="{{ s.secondary.url }}">{{ s.secondary.label | br | safe }}</a>{% endif %}
      </div>
    </div>
    <aside class="learning-journal" aria-label="네 단계 학습 흐름">
      <div class="journal-top"><span>배움의 흐름</span><span aria-hidden="true">01 — 04</span></div>
      <p class="journal-heading">분별에서 시작해,<br>나만의 도구까지.</p>
      <ol>
        {% for group in home.sections %}{% if group.id == 'for-whom' and group.enabled != false %}{% for card in group.items %}
        <li><span class="journal-number">0{{ loop.index }}</span><div><span class="journal-title">{{ card.title | oneline }}</span>{% if card.step %}<p>{{ card.step | oneline }}</p>{% endif %}</div></li>
        {% endfor %}{% endif %}{% endfor %}
      </ol>
      <p class="journal-note">천천히, 한 걸음씩 함께합니다.</p>
    </aside>
  </div>
</section>
