<section data-appearance="{{ s.appearance | dump }}" class="hero beagle-hero practical-hero" id="{{ s.id or 'hero' }}">
  <div class="hero-inner wrap-wide">
    <div class="hero-copy">
      <p class="eyebrow" data-hero-label>{{ s.label | oneline }}</p>
      <h1>{{ s.title | br | safe }}</h1>
      {% if s.lead %}<p class="lead">{{ s.lead | oneline }}</p>{% endif %}
      <div class="actions">
        {% if s.primary.label %}<a class="btn btn-primary" href="{{ s.primary.url }}">{{ s.primary.label | oneline }}</a>{% endif %}
        {% if s.secondary.label %}<a class="btn btn-secondary" href="{{ s.secondary.url }}">{{ s.secondary.label | oneline }}</a>{% endif %}
      </div>
      <p class="hero-author">목회AI 컨설턴트 {{ site.name | oneline }}</p>
    </div>
    {% if s.showcase and s.showcase.length %}
    <div class="paper-scene workbench" data-showcase>
      <div class="showcase-tabs" role="tablist" aria-label="AI 활용 예시 선택">
        {% for example in s.showcase %}<button type="button" role="tab" id="example-tab-{{ loop.index0 }}" aria-controls="example-panel-{{ loop.index0 }}" aria-selected="{% if loop.first %}true{% else %}false{% endif %}" tabindex="{% if loop.first %}0{% else %}-1{% endif %}"><span data-home-path='["showcase",{{ loop.index0 }},"label"]'>{{ example.label }}</span></button>{% endfor %}
      </div>
      {% for example in s.showcase %}
      <div class="showcase-panel" role="tabpanel" id="example-panel-{{ loop.index0 }}" aria-labelledby="example-tab-{{ loop.index0 }}" tabindex="0" {% if not loop.first %}hidden{% endif %}>
        <p class="example-caption">활용 흐름 예시</p>
        <div class="document-preview preview-{{ loop.index0 }}" aria-hidden="true">
          {% set icon = loop.index0 %}{% include "practical-icon.njk" %}
        </div>
        <h2 data-home-path='["showcase",{{ loop.index0 }},"title"]'>{{ example.title }}</h2>
        <p class="example-brief" data-home-path='["showcase",{{ loop.index0 }},"brief"]'>{{ example.brief }}</p>
        {% set exampleIndex = loop.index0 %}
        <ol class="example-flow">{% for stage in example.stages %}<li><span class="flow-dot" aria-hidden="true">{{ loop.index }}</span><span data-home-path='["showcase",{{ exampleIndex }},"stages",{{ loop.index0 }}]'>{{ stage }}</span></li>{% endfor %}</ol>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</section>
