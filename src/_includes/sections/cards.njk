{% set typography = s.typography %}
<section {% include "text-layout.njk" %} class="tone-{{ s._tone or 'light' }}" id="{{ s.id }}">
  <div class="wrap">
    <h2>{{ s.heading | br | safe }}</h2>
    {% if s.lead %}<p>{{ s.lead | br | safe }}</p>{% endif %}
  </div>
  {% if s.items and s.items.length %}
  <div class="wrap-wide">
    <div class="grid{% if s.items.length == 4 %} grid-four{% endif %}">
      {% for c in s.items %}
      {% set typography = c.typography or s.typography %}
      <div class="card" {% include "text-layout.njk" %}>
        {% if c.step %}<div class="card-step">{{ c.step | escape }}</div>{% endif %}
        <h3>{{ c.title | br | safe }}</h3>
        <p>{{ c.body | br | safe }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}
</section>
