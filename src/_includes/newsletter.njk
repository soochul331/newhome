---
layout: base.njk
---
<article class="letter-article">
  <header class="letter-heading"><a href="/newsletter/">뉴스레터 목록</a><p><time datetime="{{ date | isoDate }}">{{ date | dateKo }}</time></p><h1>{{ title | br | safe }}</h1><p>{{ summary | br | safe }}</p></header>
  {% if cover %}<img class="letter-cover" src="{{ cover }}" alt="{{ cover_alt or '' }}" decoding="async">{% endif %}
  <div class="letter-body" data-document-body>{{ content | safe }}</div>
  <footer class="letter-end"><p>Church AI Lab · 신수철 목사</p><a href="/newsletter/">전체 뉴스레터 보기</a></footer>
</article>
