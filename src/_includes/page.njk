---
layout: base.njk
---
<section {% include "text-layout.njk" %} class="hero tone-parchment">
  <div class="wrap">
    <h1>{{ title | br | safe }}</h1>
    {% if description %}<p class="lead">{{ description | br | safe }}</p>{% endif %}
  </div>
</section>
<section {% include "text-layout.njk" %} class="tone-light">
  <div class="wrap prose">
    <div data-document-body>{{ content | safe }}</div>
  </div>
</section>
